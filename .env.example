DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# docker compose (postgres container + api DATABASE_URL)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6380/0

# auth cookies (COOKIE_SECURE=false only for plain-http local dev)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
